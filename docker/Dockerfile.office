# Self-contained T-Rex office-inference submission image.
#
# Required BuildKit named contexts are supplied by build_office.sh:
#   trex       - the T-Rex source checkout
#   base_model - Qwen3-VL-2B-Instruct
#   checkpoint - the fixed T-Rex post-train checkpoint
#   stats      - directory containing the LeRobot meta/stats.json

FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MINICONDA_INSTALLER=Miniconda3-py310_25.11.1-1-Linux-x86_64.sh

ENV TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CONDA_DIR=/opt/conda \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_DATASETS_OFFLINE=1 \
    TREX_VIDEO_BACKEND=pyav \
    PYTHONPATH=/opt/trex:/opt/trex/third_party/lerobot/src \
    TREX_CHECKPOINT=/opt/policy/checkpoint \
    TREX_BASE_MODEL=/opt/trex/base_model \
    TREX_STATS_PATH=/opt/policy/assets/stats.json \
    HOME=/tmp/origami-home \
    XDG_CACHE_HOME=/tmp/origami-cache \
    HF_HOME=/tmp/origami-cache/huggingface \
    TORCH_HOME=/tmp/origami-cache/torch \
    TORCH_EXTENSIONS_DIR=/tmp/origami-cache/torch_extensions

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        pkg-config \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 policy \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin policy

RUN curl -fsSL "https://repo.anaconda.com/miniconda/${MINICONDA_INSTALLER}" \
        -o /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p "${CONDA_DIR}" \
    && rm -f /tmp/miniconda.sh \
    && "${CONDA_DIR}/bin/conda" config --system --set auto_update_conda false \
    && "${CONDA_DIR}/bin/conda" create -y -n trex \
        --override-channels --channel conda-forge python=3.10 \
    && "${CONDA_DIR}/bin/conda" clean -afy

ENV PATH=/opt/conda/envs/trex/bin:/opt/conda/bin:${PATH} \
    CONDA_DEFAULT_ENV=trex \
    CONDA_PREFIX=/opt/conda/envs/trex

COPY --from=trex --chown=65532:65532 / /opt/trex
COPY --chown=65532:65532 office_policy_server.py /opt/trex/office_policy_server.py
COPY --from=base_model --chown=65532:65532 / /opt/trex/base_model
COPY --from=checkpoint --chown=65532:65532 / /opt/policy/checkpoint
COPY --from=stats --chown=65532:65532 /stats.json /opt/policy/assets/stats.json
COPY --chown=65532:65532 OFFICE_LICENSES.md /opt/policy/licenses/OFFICE_LICENSES.md

# Keep the T-Rex environment aligned with the CUDA-12.4 training environment.
# Torch is installed first from the official cu124 index so the later pinned
# dependencies cannot resolve a CPU wheel.
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        torch==2.6.0 torchvision==0.21.0 \
        --index-url https://download.pytorch.org/whl/cu124 \
    && python -m pip install -r /opt/trex/docker/requirements-cu124.txt \
        eclipse-zenoh==1.9.0 msgpack==1.2.1 \
    && python -m pip install -e /opt/trex --no-deps \
    && python - <<'PY'
import msgpack
import torch
import torchvision
import transformers
import zenoh
from importlib.metadata import version

assert torch.version.cuda == "12.4", torch.version.cuda
assert torch.__version__.startswith("2.6.0+cu124"), torch.__version__
assert torchvision.__version__.startswith("0.21.0+cu124"), torchvision.__version__
assert transformers.__version__ == "4.57.3", transformers.__version__
assert version("eclipse-zenoh") == "1.9.0"
print("T-Rex office image dependencies:", torch.__version__, torchvision.__version__, transformers.__version__, version("eclipse-zenoh"), msgpack.__version__)
PY

WORKDIR /opt/policy
USER 65532:65532
HEALTHCHECK NONE
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/conda/envs/trex/bin/python", "/opt/trex/office_policy_server.py"]
